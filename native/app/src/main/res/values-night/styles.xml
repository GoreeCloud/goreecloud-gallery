<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GoreeCloudGallery" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/Theme.GoreeCloudGallery.AlertDialog</item>
    </style>

    <style name="Theme.GoreeCloudGallery.AlertDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#5FC9BB</item>
        <item name="android:textColorPrimary">#F5F5F7</item>
        <item name="android:textColorSecondary">#B8B8BE</item>
        <item name="android:windowBackground">@drawable/glaze_dialog_background</item>
        <item name="android:windowElevation">16dp</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.52</item>
    </style>
</resources>
